{
  "file.0000000000000001.title": "ATM Omega Edition · 0.3.0-alpha.1",
  "chapter.0100000000000001.title": "01 • Vom Überleben zur Mechanik",
  "chapter.0100000000000002.title": "02 • Von Bewegung zu Strom",
  "chapter.0100000000000003.title": "03 • Von Strom zu Magie",
  "quest.1000000000000001.title": "Willkommen in Omega",
  "quest.1000000000000001.quest_desc": [
    "Diese Alpha enthält primitive, mechanische und elektrische Progression.",
    "Öffne die Quests über dein Inventar. Folge dem Hauptpfad und baue deine eigene Fabrik.",
    "Bestätige diese Einführung. Spätere Zeitalter bleiben geplant."
  ],
  "quest.1000000000000002.title": "Ein sicherer Arbeitsplatz",
  "quest.1000000000000002.quest_desc": [
    "Halte eine Werkbank und acht Fackeln bereit. Plane Ersatzwerkzeug und einen sicheren Rückweg ein.",
    "Diese Gegenstände werden erkannt und nicht verbraucht."
  ],
  "quest.1000000000000003.title": "Proviant für die Reise",
  "quest.1000000000000003.quest_desc": [
    "Freiwilliges Nebenziel: Stelle acht Brote her. Andere Nahrung ist ebenfalls sinnvoll; diese Quest sperrt den Hauptpfad nicht.",
    "Weizen wird auch für Pflanzenfasern verwendet."
  ],
  "quest.1000000000000004.title": "Die ersten Kupferplatten",
  "quest.1000000000000004.quest_desc": [
    "Fertige jede Kupferplatte aus einem Kupferbarren und einem Feuerstein. Der Feuerstein wird verbraucht.",
    "Dieser einfache Handweg ermöglicht den ersten Kern, bevor du eine Presse besitzt.",
    "Später verarbeitet die mechanische Presse Kupferbarren ohne Feuersteinverbrauch."
  ],
  "quest.1000000000000005.title": "Primitiver Kern",
  "quest.1000000000000005.quest_desc": [
    "Ein Weizen ergibt eine Pflanzenfaser. Kombiniere einen Stamm und Feuerstein zu Baumharz.",
    "Ein primitiver Kern verbindet vier Kupferplatten, zwei Fasern, zwei Harze und Holzkohle.",
    "Du brauchst mehrere Kerne: Wasserrad, Presse und gepresster Kern verbrauchen jeweils einen."
  ],
  "quest.1000000000000006.title": "Wasser wird Bewegung",
  "quest.1000000000000006.quest_desc": [
    "Baue ein Wasserrad aus einem primitiven Kern, Wellen und Brettern.",
    "Setze es in fließendes Wasser. Create Ponder erklärt Platzierung und Rotation.",
    "Ein großes Wasserrad entsteht mit dem normalen Aufwertungsrezept."
  ],
  "quest.1000000000000007.title": "Rotation übertragen",
  "quest.1000000000000007.quest_desc": [
    "Halte acht Wellen und vier Zahnräder bereit. Verbinde das Wasserrad mit deinem Arbeitsbereich.",
    "Zahnräder ändern Richtung und Drehzahl. Nutze die im Item-Tooltip angezeigte Ponder-Taste."
  ],
  "quest.1000000000000008.title": "Deine erste mechanische Presse",
  "quest.1000000000000008.quest_desc": [
    "Fertige die Presse aus einem Eisenblock, zwei Wellen, einem Andesitgehäuse und einem weiteren primitiven Kern.",
    "Schließe Rotation an. Setze die Presse zwei Blöcke über ein Depot und lasse dazwischen einen Luftblock frei. Kupferbarren werden dort zu Platten.",
    "Prüfe Abstand und Drehzahl, falls die Presse nicht arbeitet."
  ],
  "quest.1000000000000009.title": "Ein maschinell geformter Kern",
  "quest.1000000000000009.quest_desc": [
    "Lege einen primitiven Kern auf ein Depot unter der angetriebenen Presse.",
    "Durch Pressen entsteht ein gepresster Kern. Dafür gibt es kein Handrezept.",
    "Er bildet das maschinell gefertigte Zentrum des mechanischen Kerns."
  ],
  "quest.100000000000000A.title": "Lieferauftrag: Kupferplatten",
  "quest.100000000000000A.quest_desc": [
    "Gib über diese Quest 120 Kupferplatten ab. Die Platten werden verbraucht.",
    "Dies ist ein Lieferauftrag. Er beweist weder eine Produktionsrate noch neu hergestellte Gegenstände.",
    "Trichter, Depot und angetriebene Presse ermöglichen eine wiederholbare Versorgung. Handgefertigte Platten zählen ebenfalls."
  ],
  "quest.100000000000000B.title": "Mechanischer Kern",
  "quest.100000000000000B.quest_desc": [
    "Verbinde einen gepressten Kern mit vier Andesitlegierungen, zwei Kupferplatten, einer Welle und Redstone.",
    "Schließe auch den Kupfer-Lieferauftrag ab. Die fertige Quest speichert diesen Meilenstein für dein FTB-Team.",
    "Danach darfst du den Kern lagern oder später verwenden; die abgeschlossene Quest bleibt erhalten."
  ],
  "quest.100000000000000C.title": "Erste Fabrik, erster Meilenstein",
  "quest.100000000000000C.quest_desc": [
    "Dein mechanischer Meilenstein ist erreicht. Weiter geht es in Kapitel 02: Von Bewegung zu Strom.",
    "Behalte deine Rotationsfabrik: Weitere Mechanical Cores werden für elektrische Maschinen benötigt.",
    "Sichere vor Updates die vollständige Welt einschließlich Quest- und Teamdaten."
  ],
  "quest.100000000000000D.title": "Mehr als Rotation",
  "quest.100000000000000D.quest_desc": [
    "Baue mit Mekanism die erste elektrische Werkstatt. Du benötigst weitere Mechanical Cores.",
    "Verbinde Generator und Maschine zunächst direkt. Kabel brauchen Stahl, den du erst im angetriebenen Infuser herstellst."
  ],
  "quest.100000000000000E.title": "Ein neues Metall: Osmium",
  "quest.100000000000000E.quest_desc": [
    "Baue Osmiumerz ab und schmelze es. Halte außerdem Eisen, Kupfer, Gold, Kohle und Redstone bereit.",
    "Suche in einer älteren Alpha-Welt in neu generierten Chunks nach Mekanism-Erzen. Alte Chunks werden nicht nachträglich umgebaut."
  ],
  "quest.100000000000000F.title": "Von Mechanik zu Elektrik",
  "quest.100000000000000F.quest_desc": [
    "Fertige den Metallurgic Infuser aus vier Eisenbarren, zwei Öfen, zwei Redstone und einem Mechanical Core.",
    "Der Kern wird verbraucht; der bisherige Meilenstein bleibt abgeschlossen. Der Infuser benötigt Strom."
  ],
  "quest.1000000000000010.title": "Dein erster Strom",
  "quest.1000000000000010.quest_desc": [
    "Fertige einen Heat Generator mit dem normalen Mekanism-Rezept. Gib Brennstoff wie Kohle hinein.",
    "Setze seinen vorderen Energieausgang direkt an den Infuser. So startest du ohne Stahlkabel. Prüfe die Energieanzeige des Infusers."
  ],
  "quest.1000000000000011.title": "Redstone-Komponenten",
  "quest.1000000000000011.quest_desc": [
    "In dieser Mekanism-Version entsteht Infused Alloy aus Kupfer mit Redstone-Infusion. Osmium mit Redstone-Infusion ergibt Basic Control Circuits.",
    "Redstone gehört in den Infusionsslot, das Metall in den Haupteingang. Prüfe Mengen in JEI; die Quest erkennt Items und misst keine Maschinenlaufzeit."
  ],
  "quest.1000000000000012.title": "Stahl für das Stromnetz",
  "quest.1000000000000012.quest_desc": [
    "Infundiere Eisen mit Kohlenstoff zu Enriched Iron. Eine zweite Kohlenstoff-Infusion ergibt Steel Dust; schmelze den Staub zu Stahl.",
    "Kohle oder Holzkohle liefert Kohlenstoff. Nutze einen getrennten Infuser oder entferne verbliebene Redstone-Infusion vor dem Wechsel."
  ],
  "quest.1000000000000013.title": "Strom weiterleiten",
  "quest.1000000000000013.quest_desc": [
    "Zwei Stahlbarren und Redstone ergeben acht Basic Universal Cables. Verlängere den Generatorausgang bis zur Werkstatt.",
    "Halte Energieverbindungen durchgängig. Diese Kabel übertragen Strom; Create-Wellen übertragen Rotation."
  ],
  "quest.1000000000000014.title": "Ein Puffer für die Werkstatt",
  "quest.1000000000000014.quest_desc": [
    "Fertige einen Basic Energy Cube. Das normale Rezept braucht Steel Casing und Energy Tablets; JEI zeigt die vollständige Kette.",
    "Stelle einen Eingang zum Generator und einen Ausgang zu den Maschinen ein. Lade den Speicher und prüfe die steigende Energieanzeige. Der Itemnachweis allein beweist keinen Ladezustand."
  ],
  "quest.1000000000000015.title": "Materialien aus dem Nether",
  "quest.1000000000000015.quest_desc": [
    "Bereite sicheren Netherzugang und einen Rückweg vor. Zwei Lohenstaub, zwei Quarz und eine Magmacreme ergeben Infernale Essenz.",
    "Die Quest prüft das Material und protokolliert keinen persönlichen Dimensionsbesuch. Gemeinsame Vorräte sind erlaubt."
  ],
  "quest.1000000000000016.title": "Elektrischer Kern",
  "quest.1000000000000016.quest_desc": [
    "Verbinde vier Infused Alloy, einen Basic Control Circuit, zwei Stahlbarren, Infernale Essenz und einen weiteren Mechanical Core.",
    "Du hast den elektrischen Alpha-Meilenstein erreicht. Erweitere Erzeugung, Speicher und Produktion und sichere deine Welt.",
    "Weiter geht es mit Zaubern und Ritualen im arkanen Kapitel. Eigene Omega-Bosse und Sterne bleiben geplant."
  ],
  "quest.1000000000000017.title": "Zauberkunst beginnen",
  "quest.1000000000000017.quest_desc": [
    "Fertige ein Novice Spell Book. Ars Nouveau liefert Zauber und Source; Occultism Geistermaterialien und Rituale.",
    "Lies den Ars-Leitfaden und Occultisms Dictionary of Spirits. Frühe Standardrezepte bleiben erreichbar; Apparatus und goldene Schalen brauchen elektrische Kerne."
  ],
  "quest.1000000000000018.title": "Violettes Archwood finden",
  "quest.1000000000000018.quest_desc": [
    "Finde violettes Archwood und behalte Setzlinge. Bestehende Welten benötigen unerforschte Chunks für neue Weltgenerierung.",
    "Violette Stämme werden für die Wilden-Ritualtafel gebraucht. Eine native Alternative nutzt zusätzlich Smaragdblock, Eisenschwert, Bogen und Lapislazuliblock."
  ],
  "quest.1000000000000019.title": "Eine Imbuement Chamber",
  "quest.1000000000000019.quest_desc": [
    "Fertige und platziere eine Imbuement Chamber mit ihrem Standardrezept. Die Kammer sammelt langsam selbst Source; Lapis oder Amethyst werden auch vor dem Bau eines Generators zu Source Gems.",
    "Sockel neben der Kammer wählen fortgeschrittene Rezepte aus. Die beiden Katalysatorsockel für den Runenkristall werden später benötigt."
  ],
  "quest.100000000000001A.title": "Source Gems auf Vorrat",
  "quest.100000000000001A.quest_desc": [
    "Verarbeite Lapis oder Amethyst mit dem nativen Rezept und passiver Kammer-Source. Lege einen Vorrat für Gefäße, Sourcelinks und Apparatus an.",
    "Runenkristalle brauchen später Amethyst, zwei verschiedene Sockelkatalysatoren und 500 Source. Ohne die Katalysatoren bleibt die normale Edelsteinproduktion verfügbar."
  ],
  "quest.100000000000001B.title": "Demon’s Dream anbauen",
  "quest.100000000000001B.quest_desc": [
    "Zerbrich Gras für Demon’s Dream Seeds und baue die Pflanze für ihre Früchte an. Nutze Occultisms Buch für den Einstieg.",
    "Wirf eine Frucht auf den Boden und entzünde sie mit Feuerstein und Stahl zu Spirit Fire."
  ],
  "quest.100000000000001C.title": "Materialien durch Spirit Fire",
  "quest.100000000000001C.quest_desc": [
    "Wirf ANDESIT für Otherstone und DIAMANTEN für Spirit Attuned Gems in Spirit Fire.",
    "Das sind die Rezepte von Occultism 1.224.5. Ein Diamant ergibt einen Edelstein; plane Vorräte für Apparatus und wiederverwendbare Imbuement-Katalysatoren ein."
  ],
  "quest.100000000000001D.title": "Rituale und Technik verbinden",
  "quest.100000000000001D.quest_desc": [
    "Fertige zuerst eine normale Sacrificial Bowl. Drei Goldbarren, zwei Otherstone, ein elektrischer Kern und diese Schale ergeben die Golden Sacrificial Bowl.",
    "Die dunkle Variante hat dieselben Kosten mit Dark Sacrificial Bowl. Kreide, Pentakel, Geister und weitere Rituale erklärt das native Buch."
  ],
  "quest.100000000000001E.title": "Magische Source erzeugen",
  "quest.100000000000001E.quest_desc": [
    "Fertige einen Volcanic Sourcelink und lege Brennstoff auf einen nahen Arcane Pedestal. Ein Source Jar gehört in fünf Blöcke Reichweite.",
    "Der Link verbraucht Brennstoff und überträgt Source regelmäßig. Er kann nahen Boden in Magma verwandeln; plane Abstand zu brennbaren Bauten ein. Andere native Sourcelinks sind ebenfalls möglich."
  ],
  "quest.100000000000001F.title": "Source neben den Maschinen speichern",
  "quest.100000000000001F.quest_desc": [
    "Lade ein Source Jar. Die Imbuement Chamber braucht ein Gefäß in zwei Blöcken Reichweite, der Enchanting Apparatus in zehn.",
    "Die Quest erkennt das Gefäß als Item, nicht seinen Füllstand. Prüfe die native Anzeige in der Welt; geladene Gefäße beschleunigen Imbuement; der Apparatus verlangt seine Source-Kosten."
  ],
  "quest.1000000000000020.title": "Verzauberungsstation bauen",
  "quest.1000000000000020.quest_desc": [
    "Fertige den Apparatus mit vier Goldbarren, zwei Source Gems, zwei Sourcestone und einem elektrischen Kern. Platziere ihn über dem nativen Ars-Arcane-Core-Block mit acht Arcane Pedestals in der Nähe.",
    "Der Basisblock heißt ars_nouveau:arcane_core. Der spätere arkane Omega-Kern ist ein eigenes Meilenstein-Item: omega:arcane_core."
  ],
  "quest.1000000000000021.title": "Runenkristall durch Imbuement",
  "quest.1000000000000021.quest_desc": [
    "Lege einen Source Gem und einen Spirit Attuned Gem auf zwei getrennte nahe Sockel. Gib Amethyst in die Kammer und stelle 500 Source bereit.",
    "Die Kammer verbraucht Amethyst und Source. Beide Sockelkatalysatoren bleiben wiederverwendbar."
  ],
  "quest.1000000000000022.title": "Beide Magiepfade verbinden",
  "quest.1000000000000022.quest_desc": [
    "Lege für JEDEN Binder zwei Source Gems, zwei Otherstone, zwei Goldbarren und zwei Spirit Attuned Gems auf acht getrennte Apparatus-Sockel.",
    "Gib einen elektrischen Kern in den Apparatus mit 1000 Source. Reagenz und alle acht Sockelzutaten werden verbraucht. Wiederhole den Vorgang für den zweiten Binder."
  ],
  "quest.1000000000000023.title": "Ritualplatz im Freien vorbereiten",
  "quest.1000000000000023.quest_desc": [
    "Fertige einen Ritual Brazier. Bereite Rüstung, Heilung, Essen und eine freie Arena im Außenbereich vor.",
    "Die Alpha nutzt den nativen Ars-Boss als Begegnungsprototyp für den Ancient Titan. Ein eigener Omega-Titan bleibt spätere Entwicklung."
  ],
  "quest.1000000000000024.title": "Wilden-Ritual verstärken",
  "quest.1000000000000024.quest_desc": [
    "Fertige eine Wilden-Ritualtafel. Das native Alternativrezept ist auch vor dem Sammeln der drei unterschiedlichen Wilden-Drops möglich.",
    "Setze die Tafel in den Brazier, ergänze je einen Wilden Spike, Horn und Wing als VERSTÄRKUNGEN und aktiviere ihn. Ohne alle drei erscheinen normale Wilden statt der Chimera. Beachte den nativen Ritualleitfaden."
  ],
  "quest.1000000000000025.title": "Wilden Chimera besiegen",
  "quest.1000000000000025.quest_desc": [
    "Besiege eine Wilden Chimera und behalte ihren Wilden Tribute. Die Quest verlangt sowohl den Boss-Kill als auch das Tribute-Item.",
    "Die Kill-Aufgabe prüft ars_nouveau:wilden_boss. Kills vor der Freischaltung müssen eventuell wiederholt werden. Es gelten native Kampf- und Beuteregeln."
  ],
  "quest.1000000000000026.title": "Arkaner Omega-Kern",
  "quest.1000000000000026.quest_desc": [
    "Verbinde vier Source Gems, zwei arkane Binder, einen Runenkristall, einen Spirit Attuned Gem und einen Wilden Tribute.",
    "Der Craft verbindet Mechanik, Elektrizität, beide Magiematerialpfade und einen nativen Bossdrop. Industrielle Progression und eigene Omega-Bosse folgen später. Sichere vor dem nächsten Update deine Welt."
  ]
}
