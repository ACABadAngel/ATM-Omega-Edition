{
  "file.0000000000000001.title": "ATM Omega Edition · 0.4.0-alpha.1",
  "chapter.0100000000000001.title": "01 • From Survival to Motion",
  "chapter.0100000000000002.title": "02 • From Motion to Power",
  "chapter.0100000000000003.title": "03 • From Power to Source",
  "chapter.0100000000000004.title": "04 • From Source to Industry",
  "quest.1000000000000001.title": "Welcome to Omega",
  "quest.1000000000000001.quest_desc": [
    "This alpha includes Primitive, Mechanical and Electrical progression.",
    "Open the Quests button in your inventory. Follow the main path, then build your own factory.",
    "Check this introduction to begin. Later ages remain planned."
  ],
  "quest.1000000000000002.title": "A place to work",
  "quest.1000000000000002.quest_desc": [
    "Prepare a crafting table and eight torches. Keep a spare tool and a safe route home.",
    "These items are detected without being consumed."
  ],
  "quest.1000000000000003.title": "Food for the journey",
  "quest.1000000000000003.quest_desc": [
    "Optional side goal: make eight bread. Food variety is welcome; this quest never blocks the main path.",
    "Wheat is also useful for Plant Fiber."
  ],
  "quest.1000000000000004.title": "The first copper sheets",
  "quest.1000000000000004.quest_desc": [
    "Craft each copper sheet with one copper ingot and one flint. The flint is consumed.",
    "This deliberately simple hand route lets you build the first core before you own a press.",
    "Later, a Mechanical Press processes copper ingots without the flint cost."
  ],
  "quest.1000000000000005.title": "Primitive Core",
  "quest.1000000000000005.quest_desc": [
    "One wheat makes one Plant Fiber. Combine a log and flint for Tree Resin.",
    "A Primitive Core combines four copper sheets, two fibers, two resin and charcoal.",
    "You will need multiple cores: the water wheel, press and pressed-core chain each use one."
  ],
  "quest.1000000000000006.title": "Water becomes motion",
  "quest.1000000000000006.quest_desc": [
    "Build a Water Wheel using a Primitive Core, shafts and planks.",
    "Place it in moving water. Create Ponder explains placement and rotation.",
    "A Large Water Wheel is available through the normal upgrade recipe."
  ],
  "quest.1000000000000007.title": "Move the rotation",
  "quest.1000000000000007.quest_desc": [
    "Prepare eight shafts and four cogwheels. Connect your water wheel to a work area.",
    "Use cogwheels to change direction and speed. Hold the Ponder key shown in the item tooltip."
  ],
  "quest.1000000000000008.title": "Your first mechanical press",
  "quest.1000000000000008.quest_desc": [
    "Craft the press with an iron block, two shafts, an andesite casing and another Primitive Core.",
    "Connect rotation. Place the press two blocks above a depot, leaving one air block between them. Copper ingots become sheets on the depot.",
    "Leave enough clearance and check the rotational speed if it does not move."
  ],
  "quest.1000000000000009.title": "A core shaped by machinery",
  "quest.1000000000000009.quest_desc": [
    "Place a Primitive Core on a depot under the powered press.",
    "Pressing produces a Pressed Core. This item has no hand-crafting shortcut.",
    "It is the machine-made center of your Mechanical Core."
  ],
  "quest.100000000000000A.title": "Supply contract: copper sheets",
  "quest.100000000000000A.quest_desc": [
    "Submit 120 copper sheets through this quest. These sheets are consumed.",
    "This is a delivery contract: it does not prove a production rate or newly produced items.",
    "A hopper, depot and powered press can make the supply repeatable. Hand-made sheets are also valid."
  ],
  "quest.100000000000000B.title": "Mechanical Core",
  "quest.100000000000000B.quest_desc": [
    "Combine a Pressed Core with four andesite alloy, two copper sheets, one shaft and redstone.",
    "Complete the copper delivery too. The finished quest records this milestone for your FTB team.",
    "The core may then be stored or used later; the completed quest remains recorded."
  ],
  "quest.100000000000000C.title": "First factory, first milestone",
  "quest.100000000000000C.quest_desc": [
    "Your Mechanical milestone is complete. Continue in chapter 02: From Motion to Power.",
    "Keep your rotational factory: more Mechanical Cores are needed for electrical machines.",
    "Before updating, back up your complete world and quest/team data."
  ],
  "quest.100000000000000D.title": "Beyond rotation",
  "quest.100000000000000D.quest_desc": [
    "Build the first electrical workshop using Mekanism. You need additional Mechanical Cores.",
    "Start with direct generator-to-machine contact. Cables require steel, which you will make in the powered infuser first."
  ],
  "quest.100000000000000E.title": "A new metal: osmium",
  "quest.100000000000000E.quest_desc": [
    "Mine and smelt osmium ore. Keep iron, copper, gold, coal and redstone ready too.",
    "When continuing an older alpha world, search newly generated chunks for Mekanism ores. Existing ore generation is not retroactively changed."
  ],
  "quest.100000000000000F.title": "Mechanical becomes electrical",
  "quest.100000000000000F.quest_desc": [
    "Craft the Metallurgic Infuser from four iron ingots, two furnaces, two redstone and one Mechanical Core.",
    "The core is consumed. Your earlier Mechanical milestone remains completed. The infuser will need electricity."
  ],
  "quest.1000000000000010.title": "Your first electricity",
  "quest.1000000000000010.quest_desc": [
    "Craft a Heat Generator using its normal Mekanism recipe. Add combustible fuel such as coal.",
    "Place its front energy output directly against the infuser. This starts the machine before steel cables exist. Check the infuser energy meter."
  ],
  "quest.1000000000000011.title": "Redstone-infused components",
  "quest.1000000000000011.quest_desc": [
    "In this pinned Mekanism version, copper plus redstone infusion produces Infused Alloy. Osmium plus redstone infusion produces Basic Control Circuits.",
    "Put redstone in the infusion slot and the metal in the main input. Use JEI to check quantities; the task detects items and does not measure machine uptime."
  ],
  "quest.1000000000000012.title": "Steel for the power grid",
  "quest.1000000000000012.quest_desc": [
    "Infuse iron with carbon to obtain Enriched Iron. Infuse that with carbon again to obtain Steel Dust, then smelt the dust.",
    "Coal or charcoal supplies carbon. Use a separate infuser for carbon, or clear the remaining redstone infusion before switching."
  ],
  "quest.1000000000000013.title": "Carry power further",
  "quest.1000000000000013.quest_desc": [
    "Two steel ingots and redstone craft eight Basic Universal Cables. Extend the generator output to your workshop.",
    "Keep energy connections continuous. These cables move electricity; Create shafts move rotation."
  ],
  "quest.1000000000000014.title": "A buffer for your workshop",
  "quest.1000000000000014.quest_desc": [
    "Craft a Basic Energy Cube. Its normal recipe uses a Steel Casing and Energy Tablets; JEI shows the full recipe.",
    "Configure an input toward the generator and an output toward machines. Charge it and verify that the energy meter increases. Item detection alone does not prove it is charged."
  ],
  "quest.1000000000000015.title": "Materials from the Nether",
  "quest.1000000000000015.quest_desc": [
    "Prepare safe Nether access and a return route. Combine two blaze powder, two quartz and one magma cream into Infernal Essence.",
    "This quest checks the material. It does not record a personal dimension visit; shared supplies are allowed."
  ],
  "quest.1000000000000016.title": "Electrical Core",
  "quest.1000000000000016.quest_desc": [
    "Combine four Infused Alloy, a Basic Control Circuit, two steel ingots, Infernal Essence and another Mechanical Core.",
    "You have reached the alpha Electrical milestone. Expand generation, storage and production, then back up your world.",
    "Continue with spellcraft and rituals in the Arcane chapter. Custom Omega bosses and stars remain planned."
  ],
  "quest.1000000000000017.title": "Begin spellcraft",
  "quest.1000000000000017.quest_desc": [
    "Craft a Novice Spell Book. Ars Nouveau handles spells and source; Occultism provides spirit materials and rituals.",
    "Read the native Ars guide and Occultism’s Dictionary of Spirits. Their normal early recipes remain available; the shared apparatus and golden bowls require Electrical Cores."
  ],
  "quest.1000000000000018.title": "Find purple Archwood",
  "quest.1000000000000018.quest_desc": [
    "Find purple Archwood and retain saplings. Existing worlds need unexplored chunks for newly added world generation.",
    "Purple logs are used in the Wilden summoning tablet. A native alternative uses an emerald block, iron sword, bow, lapis block and purple log."
  ],
  "quest.1000000000000019.title": "An Imbuement Chamber",
  "quest.1000000000000019.quest_desc": [
    "Craft and place an Imbuement Chamber using the native recipe. It slowly gathers its own source, so lapis or amethyst can become Source Gems before you build a generator.",
    "Pedestals near the chamber select advanced recipes. Keep the two Runic Crystal catalyst pedestals for the later step."
  ],
  "quest.100000000000001A.title": "Grow a Source Gem supply",
  "quest.100000000000001A.quest_desc": [
    "Imbue lapis or amethyst using the native recipe with passive chamber source. Build a supply for jars, sourcelinks and apparatus recipes.",
    "Later Runic Crystals need amethyst, two different pedestal catalysts and 500 source. Plain gem production remains available with the catalysts removed."
  ],
  "quest.100000000000001B.title": "Demon’s Dream cultivation",
  "quest.100000000000001B.quest_desc": [
    "Break grass for Demon’s Dream Seeds and grow the crop for its fruit. Consult Occultism’s book for the early steps.",
    "Throw the fruit onto the ground and ignite it with flint and steel to create Spirit Fire."
  ],
  "quest.100000000000001C.title": "Materials through Spirit Fire",
  "quest.100000000000001C.quest_desc": [
    "Drop ANDESITE into Spirit Fire for Otherstone. Drop DIAMONDS into Spirit Fire for Spirit Attuned Gems.",
    "These are the recipes in Occultism 1.224.5. Each diamond becomes one gem; keep extras for apparatus recipes and reusable imbuement catalysts."
  ],
  "quest.100000000000001D.title": "Link rituals to engineering",
  "quest.100000000000001D.quest_desc": [
    "Craft a normal Sacrificial Bowl first. Three gold ingots, two Otherstone, an Electrical Core and that bowl make the Golden Sacrificial Bowl.",
    "The dark variant has the same cost with a Dark Sacrificial Bowl. Follow the native book for chalk, pentacles, spirits and further rituals."
  ],
  "quest.100000000000001E.title": "Generate magical source",
  "quest.100000000000001E.quest_desc": [
    "Craft a Volcanic Sourcelink and supply burnable fuel on a nearby Arcane Pedestal. Place a Source Jar within five blocks.",
    "The link consumes fuel and transfers source periodically. It can heat nearby ground into magma; place this setup away from flammable builds. Other native sourcelinks are valid alternatives."
  ],
  "quest.100000000000001F.title": "Store source beside your machines",
  "quest.100000000000001F.quest_desc": [
    "Charge a Source Jar. Place one within two blocks of the Imbuement Chamber, and within ten blocks of the Enchanting Apparatus.",
    "This quest detects a jar item, not its stored source. Check the native meter in the world; charged jars speed imbuement, and the apparatus requires its source payment."
  ],
  "quest.1000000000000020.title": "Build the enchanting station",
  "quest.1000000000000020.quest_desc": [
    "Craft the apparatus with four gold ingots, two Source Gems, two Sourcestone and an Electrical Core. Place it above the native Ars Arcane Core block, with eight Arcane Pedestals nearby.",
    "That base block is ars_nouveau:arcane_core. The later Omega Arcane Core is a separate milestone item: omega:arcane_core."
  ],
  "quest.1000000000000021.title": "Imbue the Runic Crystal",
  "quest.1000000000000021.quest_desc": [
    "Place one Source Gem and one Spirit Attuned Gem on two separate nearby pedestals. Insert amethyst into the Imbuement Chamber with 500 source available.",
    "The chamber consumes the amethyst and source. Both pedestal catalysts remain reusable."
  ],
  "quest.1000000000000022.title": "Bind the two magic paths",
  "quest.1000000000000022.quest_desc": [
    "For EACH binder, place two Source Gems, two Otherstone, two gold ingots and two Spirit Attuned Gems on eight separate apparatus pedestals.",
    "Insert an Electrical Core into the apparatus with 1000 source available. The reagent and all eight pedestal ingredients are consumed. Repeat for a second binder."
  ],
  "quest.1000000000000023.title": "Prepare an outdoor ritual site",
  "quest.1000000000000023.quest_desc": [
    "Craft a Ritual Brazier. Prepare armor, healing, food and a clear outdoor arena before summoning the Wilden Chimera.",
    "The alpha uses the native Ars boss as the Ancient Titan encounter prototype. A custom Omega Titan remains future development."
  ],
  "quest.1000000000000024.title": "Augment the Wilden ritual",
  "quest.1000000000000024.quest_desc": [
    "Make a Wilden summoning tablet. The native alternate recipe lets you obtain it before collecting the three different Wilden drops.",
    "Use the tablet in the brazier, add one Wilden Spike, Horn and Wing as AUGMENTS, then activate it. Without all three augments the ritual summons ordinary Wilden, not the Chimera. Follow the native ritual guide."
  ],
  "quest.1000000000000025.title": "Defeat the Wilden Chimera",
  "quest.1000000000000025.quest_desc": [
    "Defeat one Wilden Chimera and retain its Wilden Tribute. This quest requires both the real boss kill and the tribute item.",
    "The kill task targets ars_nouveau:wilden_boss. Boss kills before this quest is unlocked may need repeating. Native combat and loot rules apply."
  ],
  "quest.1000000000000026.title": "Omega Arcane Core",
  "quest.1000000000000026.quest_desc": [
    "Combine four Source Gems, two Arcane Binder, one Runic Crystal, one Spirit Attuned Gem and one Wilden Tribute.",
    "Continue into Industrial Age with latex, processors and digital storage. Custom Omega bosses remain future work; back up before updating."
  ],
  "quest.1000000000000027.title": "Connect the workshop",
  "quest.1000000000000027.quest_desc": [
    "This chapter joins AE2 storage, Industrial Foregoing latex processing and Mekanism chemistry. Keep expanding Mechanical and Electrical Core production.",
    "Several entry crafts consume Arcane Cores. Plan repeatable Wilden Tribute collection and source generation. Quests guide the order; native later content still needs a complete gate audit."
  ],
  "quest.1000000000000028.title": "Charge Certus Quartz",
  "quest.1000000000000028.quest_desc": [
    "Find an AE2 meteorite and Certus Quartz. Craft a Charger with its native recipe and supply FE from your existing electrical workshop.",
    "Open the AE2 GuideME guide for meteorites, budding quartz and growth. Newly added meteorites require unexplored chunks."
  ],
  "quest.1000000000000029.title": "Fluix crystal bootstrap",
  "quest.1000000000000029.quest_desc": [
    "Charge Certus Quartz. Drop Charged Certus, Nether Quartz and Redstone together into water for the native Fluix reaction.",
    "Keep additional charged quartz for future batches. Charging and crystal conversion are different operations."
  ],
  "quest.100000000000002A.title": "Build the processor station",
  "quest.100000000000002A.quest_desc": [
    "The Inscriber now needs five iron ingots, two pistons, copper and an Electrical Core. Obtain native presses through meteorite progression.",
    "The native processor recipes retain their presses. The Omega Industrial Circuit is a separate PRESS recipe that consumes its plastic and reinforced alloy."
  ],
  "quest.100000000000002B.title": "Native logic and engineering",
  "quest.100000000000002B.quest_desc": [
    "Use the appropriate presses for printed gold/diamond circuits and silicon. Combine the printed pieces with redstone in the Inscriber.",
    "Read JEI for the exact native inputs and keep the presses. A powered Inscriber performs the actual processing; owning it alone is insufficient."
  ],
  "quest.100000000000002C.title": "Supply an ME network",
  "quest.100000000000002C.quest_desc": [
    "Craft an Energy Acceptor with four iron ingots, four Quartz Glass and an Arcane Core. Connect an FE source.",
    "Block and cable-part acceptors can still convert in both directions without another core. Native alternative power sources remain available."
  ],
  "quest.100000000000002D.title": "A terminal for your workshop",
  "quest.100000000000002D.quest_desc": [
    "Build Fluix Glass Cable and an ME Terminal using native recipes. Join the acceptor, storage and terminal into a continuous powered network.",
    "A small controller-free network supports up to eight channels. Each connected device may consume a channel; an Industrial Core later unlocks the ME Controller."
  ],
  "quest.100000000000002E.title": "Start with small storage cells",
  "quest.100000000000002E.quest_desc": [
    "Craft native 1k storage components and an item storage cell. Keep a separate empty 1k component for the Industrial Core recipe.",
    "The milestone consumes bare components, not filled storage cells. Store valuable items only after checking that your network is powered and the cell is accessible."
  ],
  "quest.100000000000002F.title": "Put the storage online",
  "quest.100000000000002F.quest_desc": [
    "The ME Drive uses four iron ingots, two Engineering Processors, two Fluix Glass Cables and an Arcane Core. Add an Energy Cell buffer.",
    "Insert the item cell in the drive and use the terminal to store and retrieve a test stack. The quest detects items; it does not measure whether the network is online."
  ],
  "quest.1000000000000030.title": "Extract latex from logs",
  "quest.1000000000000030.quest_desc": [
    "The Fluid Extractor recipe uses an Electrical Core instead of the Pity Machine Frame. Point its working side at a suitable log.",
    "It can work slowly without FE; powered operation improves yield. Acacia logs have a better native latex yield than oak. Logs eventually change or break."
  ],
  "quest.1000000000000031.title": "Process latex with water",
  "quest.1000000000000031.quest_desc": [
    "Craft the Latex Processing Unit with four iron ingots, redstone block, two buckets, a furnace and an Arcane Core. Supply FE, latex and water.",
    "In this pinned build, 750 mB latex and 500 mB water produce one Dry Rubber directly. It does not use the older tiny-rubber crafting chain."
  ],
  "quest.1000000000000032.title": "Make plastic in batches",
  "quest.1000000000000032.quest_desc": [
    "Smelt Dry Rubber in a furnace to obtain plastic. Stockpile it for circuits and the Industrial Core.",
    "Route latex and water into the appropriate inputs. Keep water generation continuous and check fluid-side configuration before connecting pipes."
  ],
  "quest.1000000000000033.title": "Diamond infusion",
  "quest.1000000000000033.quest_desc": [
    "Crush diamonds into Diamond Dust, then infuse Infused Alloy using the diamond type. Two dust supply the 20 infusion units needed for one Reinforced Alloy; Enriched Diamond is a more efficient native alternative.",
    "Keep a separate infuser or clear its remaining infusion before switching types. This step reuses the electrical production workshop."
  ],
  "quest.1000000000000034.title": "Split water into gases",
  "quest.1000000000000034.quest_desc": [
    "Supply water and FE to a native Electrolytic Separator. It produces hydrogen and oxygen in separate chemical tanks.",
    "The machine stops when either output is full. Configure both outputs; native excess-dump settings can keep one useful output running."
  ],
  "quest.1000000000000035.title": "Route both chemical outputs",
  "quest.1000000000000035.quest_desc": [
    "Use native pressurized tubes and chemical tanks for hydrogen and oxygen. Mechanical pipes carry liquids; pressurized tubes carry chemicals.",
    "An item task only detects the tanks, not their contents. Check the machine and tank displays to confirm actual production and transfer."
  ],
  "quest.1000000000000036.title": "Store chemicals in ME",
  "quest.1000000000000036.quest_desc": [
    "Applied Mekanistics adds chemical cells for your AE2 drive. Craft a chemical cell housing and combine it with a 1k component.",
    "Use the native interfaces and terminal support for Mekanism chemical keys. Keep a separate bare housing for the Industrial Core; do not dismantle a filled cell."
  ],
  "quest.1000000000000037.title": "Press the shared industrial circuit",
  "quest.1000000000000037.quest_desc": [
    "In the Inscriber place plastic in the top slot, an Electrical Core in the middle, and Reinforced Alloy in the bottom. Supply FE.",
    "This is PRESS mode: all three materials are consumed for ONE Industrial Circuit. Make two circuits for the milestone."
  ],
  "quest.1000000000000038.title": "Industrial Core",
  "quest.1000000000000038.quest_desc": [
    "Combine four plastic, two Industrial Circuits, an empty chemical cell housing, an Arcane Core and a bare 1k storage component.",
    "The recipe combines biological feedstock, native diamond infusion, AE2 processing, chemical-storage components and the earlier magic milestone. Filled storage cells are not ingredients."
  ],
  "quest.1000000000000039.title": "Expand beyond eight channels",
  "quest.1000000000000039.quest_desc": [
    "Craft a controller from four Smooth Sky Stone, four Fluix Crystals and an Industrial Core. Read the native guide for channel routing and controller structure rules.",
    "The old controller recipe is removed. Build your network capacity around real demand and provide enough generation and buffering."
  ],
  "quest.100000000000003A.title": "Prepare native autocrafting",
  "quest.100000000000003A.quest_desc": [
    "Build a Molecular Assembler and Pattern Provider. The native guide explains crafting CPUs, encoded patterns and the additional parts needed for a working system.",
    "Test a small recipe before expanding the factory. This quest detects two parts, not a completed autocrafting job. Dimensional Age and later Omega systems remain planned."
  ]
}
